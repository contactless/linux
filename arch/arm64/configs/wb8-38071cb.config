# Wiren Board 8 38071cb specific kernel options (no modules; all builtin)

#
# Usable kernel options
#

# Disable localversion, we include it in our package version suffix
# CONFIG_LOCALVERSION_AUTO is not set

# Disable debug info
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set

# Disable preempt, it breaks something during shutdown
# CONFIG_PREEMPT is not set

# Add cpufreq_nvmem driver as built-in to make it available on boot
CONFIG_ARM_ALLWINNER_SUN50I_CPUFREQ_NVMEM=y

# Device tree overlays in configfs (for wb-hwconf-manager)
CONFIG_OF_OVERLAY=y
CONFIG_OF_CONFIGFS=y

# Make GPIO available in userspace
CONFIG_EXPERT=y
CONFIG_NAMESPACES=y
CONFIG_GPIO_SYSFS=y

# IIO sensors support (used in wb-mqtt-adc)
CONFIG_SENSORS_IIO_HWMON=y
CONFIG_IIO_RESCALE=y

# Godex printer support
CONFIG_USB_PRINTER=y

# QR scanner support
CONFIG_USB_SERIAL_PL2303=y

# CPU frequency governors
CONFIG_DEVFREQ_GOV_USERSPACE=y
CONFIG_DEVFREQ_GOV_PASSIVE=y

# Netfilter support
CONFIG_BRIDGE=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_TUNNEL=y
CONFIG_NFT_OBJREF=y
CONFIG_NFT_QUEUE=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_HASH=y
CONFIG_NFT_XFRM=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_OSF=y
CONFIG_NFT_TPROXY=y
CONFIG_NFT_SYNPROXY=y
CONFIG_NFT_DUP_NETDEV=y
CONFIG_NFT_FWD_NETDEV=y

# strongSwan
# https://docs.strongswan.org/docs/5.9/install/kernelModules.html
CONFIG_XFRM_USER=y
CONFIG_INET=y
CONFIG_INET_AH=y
CONFIG_INET_ESP=y
CONFIG_INET_IPCOMP=y
CONFIG_IPV6=y
CONFIG_INET6_AH=y
CONFIG_INET6_ESP=y
CONFIG_INET6_IPCOMP=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y
CONFIG_INET_XFRM_MODE_TRANSPORT=y
CONFIG_INET_XFRM_MODE_TUNNEL=y
CONFIG_INET_XFRM_MODE_BEET=y
CONFIG_INET6_XFRM_MODE_TRANSPORT=y
CONFIG_INET6_XFRM_MODE_TUNNEL=y
CONFIG_INET6_XFRM_MODE_BEET=y

# CAN support
CONFIG_CAN=y
CONFIG_CAN_GS_USB=y

# Docker
CONFIG_BLK_CGROUP=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_BONDING=y
CONFIG_DUMMY=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_AF_KCM=y

# PPP
CONFIG_PPP=y
CONFIG_PPP_BSDCOMP=y
CONFIG_PPP_DEFLATE=y
CONFIG_PPP_FILTER=y
CONFIG_PPP_MPPE=y
CONFIG_PPP_MULTILINK=y
CONFIG_PPP_ASYNC=y
CONFIG_PPP_SYNC_TTY=y

# File systems support
CONFIG_MSDOS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y

# Detect lockups and hangs to reboot the system
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=300
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_WQ_WATCHDOG=y
CONFIG_WQ_CPU_INTENSIVE_REPORT=y
CONFIG_TEST_LOCKUP=y

# Thermal interfaces
CONFIG_THERMAL_NETLINK=y
CONFIG_THERMAL_STATISTICS=y
CONFIG_THERMAL_DEBUGFS=y
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=5000
CONFIG_THERMAL_WRITABLE_TRIPS=y

# Required by some customers
CONFIG_SYSVIPC=y

#
# Special hardware support
#

# Add I2C as built-in to make PMIC available on boot
CONFIG_I2C=y

# I2C-GPIO to communicate with WBEC, ATECC and others
CONFIG_I2C_GPIO=y

# WBEC
CONFIG_MFD_WBEC=y
CONFIG_INPUT_WBEC_PWRBUTTON=y
CONFIG_GPIO_WBEC=y
CONFIG_WBEC_POWER=y
CONFIG_WBEC_WATCHDOG=y
CONFIG_RTC_DRV_WBEC=y
CONFIG_WBEC_ADC=y
CONFIG_WBEC_BATTERY=y
CONFIG_PWM_WBEC=y
CONFIG_SERIAL_WBEC=y

# SD3078 RTC (optional on boards without WBEC)
CONFIG_RTC_DRV_SD3078=y

# Ethernet
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_MDIO_BITBANG=y
CONFIG_DWMAC_SUN8I=y

# Set number of UARTs for 8250 driver
CONFIG_SERIAL_8250_NR_UARTS=6
CONFIG_SERIAL_8250_RUNTIME_UARTS=6

# WBMZ5 (axp20x and thermistor on ADC)
CONFIG_BATTERY_AXP20X=y
CONFIG_AXP20X_POWER=y
CONFIG_AXP20X_ADC=y
CONFIG_SENSORS_NTC_THERMISTOR=y

# WBC-modem
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_WWAN=y

# PPP
CONFIG_SLHC=y
CONFIG_PPP=y

# 1-Wire
CONFIG_W1=y
CONFIG_W1_MASTER_GPIO=y

# DS18B20 temperature sensor
CONFIG_W1_SLAVE_THERM=y

# WBE-AO-10V-2 DAC internal module
CONFIG_MCP4728=y

# WBE3-R-GPS internal module
CONFIG_PPS_CLIENT_GPIO=y

# WBIO-AO-10V-8 DAC external module
# AD5064 does not set modalias, so it must be builtin
CONFIG_AD5064=y

# WBIO-DI-* and WBIO-DO-* modules
CONFIG_PINCTRL_MCP23S08=y

# USB
CONFIG_USB_CONN_GPIO=y

# PWM
CONFIG_PWM_SUN20I=y

# Wireguard
CONFIG_NET_UDP_TUNNEL=y
CONFIG_CRYPTO_ALGAPI=y
CONFIG_WIREGUARD=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_NF_RAW=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP_NF_RAW=y

#
# 38071cb specific features
#

CONFIG_BPF_SYSCALL=y
CONFIG_NET_L3_MASTER_DEV=y
CONFIG_I2C_MUX=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRC_ITU_T=y
CONFIG_CRC7=y
CONFIG_DMA_CMA=y
# CONFIG_WIRELESS is not set
CONFIG_USB=y
CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_MASS_STORAGE=y
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_ETH_RNDIS=y
CONFIG_USB_FUNCTIONFS=y
CONFIG_USB_FUNCTIONFS_RNDIS=y
CONFIG_VLAN_8021Q=y

#
# Remove unused target platforms except Allwinner
#

# CONFIG_ARCH_ACTIONS is not set
CONFIG_ARCH_SUNXI=y
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set

#
# Remove large unused drivers to save disk space
#

# CONFIG_PCI is not set
# CONFIG_SURFACE_PLATFORMS is not set
# CONFIG_CHROME_PLATFORMS is not set
