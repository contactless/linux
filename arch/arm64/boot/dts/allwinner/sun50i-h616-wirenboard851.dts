/dts-v1/;
#include "sun50i-h616-wirenboard85x.dtsi"

/ {
	model = "Wiren Board rev. 8.5.1 (T507)";
	compatible = "wirenboard,wirenboard-851", "wirenboard,wirenboard-85x", "wirenboard,wirenboard-8xx", "allwinner,sun50i-h616";

	a1_volt: a1-volt {
		compatible = "voltage-divider";
		io-channels = <&wbec_adc 6>;
		#io-channel-cells = <1>;

		output-ohms = <10000>;
		full-ohms = <110000>;
		status = "okay";
	};

	a2_volt: a2-volt {
		compatible = "voltage-divider";
		io-channels = <&wbec_adc 7>;
		#io-channel-cells = <1>;

		output-ohms = <10000>;
		full-ohms = <110000>;
	};

	a3_volt: a3-volt {
		compatible = "voltage-divider";
		io-channels = <&wbec_adc 8>;
		#io-channel-cells = <1>;

		output-ohms = <10000>;
		full-ohms = <110000>;
	};

	a4_volt: a4-volt {
		compatible = "voltage-divider";
		io-channels = <&wbec_adc 9>;
		#io-channel-cells = <1>;

		output-ohms = <10000>;
		full-ohms = <110000>;
	};
	connector {
		compatible = "hdmi-connector";
		type = "d";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	reserved-memory {
		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			/*
			 * Allocate 256 MiB specifically for the display engine: this easily
			 * covers 4K @ 32 bpp with double/triple buffering and DE overhead
			 */
			size = <0x0 0x10000000>;           // 256 MiB

			/*
			 * Constrain the pool to the first 2 GiB because a number of peripherals
			 * on H616 can only DMA within the 32-bit address space.
			 */
			alloc-ranges = <0x0 0x00000000 0x0 0x80000000>; /* 0 … 2 GiB */
			linux,cma-default;
		};
	};


};

&display_engine {
	status = "okay";
};

&hdmi {
	hvcc-supply = <&reg_aldo1>;
	status = "okay";
};

&hdmi_out {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

&gpu {
	operating-points-v2 = <&gpu_opp_table>;
	mali-supply = <&reg_dcdc4>;
	status = "okay";
};
