	"", "", "RS-485-2 TX", "RS-485-2 RX",  /* 4-7 */
	"W1 UP", "A3 OUT", "X32FKOUT", "A4 OUT",  /* 8-11 */
	"ON PERIPH", "5V_OUT ON", "GSM PWRKEY", "RS-485-1 TX",  /* 12-15 */
	"RS-485-1 RX", "", "", "",  /* 16-19 */
